SECRET_KEY=dev
DATABASE_URL=sqlite:///estoque.db
GOOGLE_MAPS_API_KEY=
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
CEP_ORIGEM=
EMAIL_LOJA_CONTATO=

MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
# Secret gerada no painel do Mercado Pago (Webhooks > Assinatura secreta) para validar a origem do webhook
MERCADOPAGO_WEBHOOK_SECRET=

# Meta Pixel / Conversions API (rastreamento de anúncios do Instagram/Facebook).
# Pixel ID: Gerenciador de Eventos > (nome do pixel), aparece no topo da página.
# Token: Gerenciador de Eventos > pixel > Configurações > API de Conversões > Gerar token de acesso.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# E-mail transacional (confirmação de pedido, pagamento aprovado, pedido enviado).
# Se ficarem vazios, o envio de e-mail é pulado silenciosamente (não quebra o checkout).
# Para Gmail: ative a verificação em 2 etapas e gere uma "Senha de app" em
# https://myaccount.google.com/apppasswords — use essa senha aqui, não a senha normal da conta.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Para onde vai o aviso de "novo pedido" para a lojista. Se vazio, usa o próprio MAIL_USERNAME.
ADMIN_NOTIFICATION_EMAIL=

# Acesso VPS (usado apenas pelos scripts locais de deploy)
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
